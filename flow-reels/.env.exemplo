# Copie este arquivo para .env e preencha o que for usar.
# O .env nunca deve ser compartilhado nem versionado.

# Transcricao na nuvem (recomendado). Crie em https://replicate.com/account/api-tokens
# Custo aproximado: alguns centavos de dolar por video de 10 minutos.
# Sem esta chave o pacote usa o WhisperX local, que e gratuito e mais lento.
REPLICATE_API_TOKEN=

# Publicacao (opcional). A chave fica no painel da Zernio, na area de API.
# Ela so e usada na ultima etapa, que e opcional: publicar ou agendar o corte
# aprovado e montar o funil "comenta a palavra, recebe o link na DM".
# Sem esta chave o pacote funciona inteiro ate a revisao. So a publicacao para,
# e ela para dizendo o que falta, com o MP4 ja pronto no disco.
ZERNIO_API_KEY=

# As contas conectadas na Zernio. Descubra os ids uma vez, com:
#   flow-reels publicar/zernio contas
# Sem o id do Instagram nao da para publicar la nem criar funil; sem o do
# YouTube nao da para publicar no YouTube. Um nao atrapalha o outro.
ZERNIO_IG_ACCOUNT_ID=
ZERNIO_YT_ACCOUNT_ID=

# Opcionais. ZERNIO_PROFILE_ID so serve se a descoberta automatica do perfil
# errar, e ZERNIO_API_BASE so serve para apontar para outro host da API.
# Deixe as duas de fora se nao souber para que servem.
# ZERNIO_PROFILE_ID=
# ZERNIO_API_BASE=

# Reddit pela API oficial (opcional, gratuito). Sem estas duas, o /flow-reels:tendencias lê o Reddit
# sem chave nenhuma (listagem e comentários com voto real), que já basta na maioria das buscas.
# Para criar: entre em https://www.reddit.com/prefs/apps com a sua conta, clique em
# "create another app", escolha o tipo "script", ponha qualquer nome e, em redirect uri,
# http://localhost:8080. O client id é o código embaixo do nome do app; o secret aparece
# no campo "secret". A chave só lê posts públicos: não posta nem vota nada.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Bancos de imagem (opcional, gratuito). Sem estas chaves, o buscar-imagem.py usa o Openverse e o
# Wikimedia Commons, que não pedem chave. Com elas, soma o Pexels e o Pixabay: fotos de uso comercial
# liberado, sem crédito obrigatório. Crie em https://www.pexels.com/api/ e https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Tendências por tema (opcional). Sem estas, o /flow-reels:tendencias pesquisa Reddit, Hacker News,
# YouTube e a web, de graça. XAI_API_KEY acrescenta o X (antigo Twitter), pela API da xAI, que cobra
# por uso. OPENAI_API_KEY só entra como reforço do Reddit quando a busca sem chave volta vazia.
XAI_API_KEY=
OPENAI_API_KEY=

# Reel narrado (/flow-reels:narrado, opcional). Voz da ElevenLabs por cima de filmagem real.
# A chave fica no painel da ElevenLabs, em API Keys. O id da voz é o da voz que você quer usar: a sua,
# clonada, ou uma da biblioteca deles. Sem as duas, o reel narrado diz o que falta e para; o resto do
# pacote não usa a ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# O modelo de voz. O padrão, eleven_multilingual_v2, fala português.
# ELEVENLABS_MODELO=eleven_multilingual_v2
