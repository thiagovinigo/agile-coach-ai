{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "contexto/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "flowgrammers-skills-main/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "images/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "agent-skills/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "pm-skills-claude-code/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "templates/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "openwiki/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "banana-slides/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "nj-mmo/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "spec-driven/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "ruflo/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "flow-reels/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "demos-rag/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "demos-cicd/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "demos-scraping/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
